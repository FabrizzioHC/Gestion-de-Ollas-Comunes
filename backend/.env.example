# Configuración de Red Comunitaria

# Entorno (development, production)
FLASK_ENV=development

# Secreto JWT (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# Base de Datos
DATABASE_URL=sqlite:///redcomunitaria.db

# Flask
FLASK_DEBUG=True
FLASK_APP=app.py

# CORS (para desarrollo, incluir localhost:8000)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Puerto del servidor
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
